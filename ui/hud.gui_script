-- Draws the HUD layout published in ui/models ("hud"). Buttons ease in and out as the layout
-- gains or loses them (gone at once while a screen change covers the screen); rail buttons also
-- slide in from their screen edge. Each element is drawn again only when its spec (the same table
-- while the layout is unchanged) or its easing changes.
local models = require "ui.models"
local motion = require "view.motion"
local memo = require "core.memo"
local draw = require "ui.draw"

local theme = require "view.theme"

local FACE = theme.vec(theme.ui.face)
local TEXT = { title = theme.vec(theme.ui.ink), body = theme.vec(theme.ui.ink) }
local ICON = theme.vec(theme.ui.icon)
local SHADOW = theme.vec(theme.ui.shadow)
local LIFT = theme.ui.lift
local EASE_RATE = 14
local PULSE = 0.86

local function createButton(id)
	local shadow = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0))
	gui.set_texture(shadow, "hud")
	gui.play_flipbook(shadow, "key")
	local face = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0))
	gui.set_texture(face, "hud")
	gui.play_flipbook(face, "key")
	local icon = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0))
	gui.set_texture(icon, "hud")
	gui.play_flipbook(icon, id)
	gui.set_color(icon, ICON)
	gui.set_parent(icon, face)
	return { face = face, shadow = shadow, icon = icon, shown = 0, scale = 1, enabled = 1, last = nil, drawn = {} }
end

function init(self)
	self.buttons = {}
	self.labels = {}
	self.present = {}
	self.present_labels = {}
end

local EMPTY = { buttons = {}, labels = {} }

-- The tooltip: a small white key with ink text, raised above the buttons whenever new ones appear.
local function drawTooltip(self, spec, k)
	local tip = self.tip
	if not tip then
		tip = { shadow = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0)), face = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0)), text = gui.new_text_node(vmath.vector3(), ""), shown = 0 }
		for _, node in ipairs({ tip.shadow, tip.face }) do
			gui.set_texture(node, "hud")
			gui.play_flipbook(node, "key")
			gui.set_slice9(node, draw.SLICE)
		end
		gui.set_font(tip.text, "body")
		gui.set_pivot(tip.text, gui.PIVOT_CENTER)
		for _, node in ipairs({ tip.shadow, tip.face, tip.text }) do
			gui.set_enabled(node, false)
		end
		self.tip = tip
	end
	if self.raise_tip then
		for _, node in ipairs({ tip.shadow, tip.face, tip.text }) do
			gui.move_above(node, nil)
		end
		self.raise_tip = false
	end
	local shown = spec and motion.ease(tip.shown, 1, k) or 0
	if shown == tip.shown and (spec or tip.last) == tip.last then
		return
	end
	tip.shown = shown
	tip.last = spec or tip.last
	local t = tip.last
	for _, node in ipairs({ tip.shadow, tip.face, tip.text }) do
		gui.set_enabled(node, t ~= nil and tip.shown > 0.01)
	end
	if not t then
		return
	end
	draw.placeBar(tip.shadow, t.x, t.y - t.h * LIFT, t.w, t.h, draw.withAlpha(SHADOW, tip.shown))
	draw.placeBar(tip.face, t.x, t.y, t.w, t.h, draw.withAlpha(FACE, tip.shown))
	draw.setText(tip.text, "body", t.text, t.x, t.y, t.size, draw.withAlpha(TEXT.body, tip.shown))
end

local function createLabel(spec)
	local node = gui.new_text_node(vmath.vector3(), "")
	gui.set_font(node, spec.style)
	gui.set_pivot(node, gui.PIVOT_CENTER)
	return { node = node, shown = 0, scale = spec.id == "banner" and 0.6 or 1, drawn = {} }
end

local function drawLabel(label, k)
	local spec = label.last
	label.scale = motion.ease(label.scale, 1, k)
	if not memo.changed(label.drawn, spec, label.shown, label.scale) then
		return
	end
	local s = spec.size / draw.FONT_SIZE[spec.style] * label.scale
	gui.set_text(label.node, spec.text)
	gui.set_screen_position(label.node, vmath.vector3(spec.x, spec.y, 0))
	gui.set_scale(label.node, vmath.vector3(s, s, 1))
	gui.set_color(label.node, draw.withAlpha(TEXT[spec.style], label.shown))
	gui.set_enabled(label.node, label.shown > 0.01)
end

-- Labels fade in and out with the layout; the banner pops in from a smaller scale each time.
local function updateLabels(self, layout, k, covered)
	local present = self.present_labels
	for id in pairs(present) do
		present[id] = nil
	end
	for _, spec in ipairs(layout.labels) do
		local label = self.labels[spec.id] or createLabel(spec)
		self.labels[spec.id] = label
		label.last = spec
		present[spec.id] = true
	end
	for id, label in pairs(self.labels) do
		label.shown = (covered and not present[id]) and 0 or motion.ease(label.shown, present[id] and 1 or 0, k)
		if not present[id] and id == "banner" then
			label.scale = 0.6
		end
		drawLabel(label, k)
	end
end

local function drawButton(b)
	local spec = b.last
	if not spec or not memo.changed(b.drawn, spec, b.shown, b.enabled, b.scale) then
		return
	end
	local slide = spec.slide and spec.slide * (1 - b.shown) * spec.size * 1.5 or 0
	local visible = b.shown > 0.01
	gui.set_enabled(b.face, visible)
	gui.set_enabled(b.shadow, visible)
	local pressed = spec.held and 1 or (1 - b.scale) / (1 - PULSE)
	local size = spec.size
	local drop = LIFT * spec.size
	gui.set_screen_position(b.face, vmath.vector3(spec.x + slide, spec.y - drop * pressed, 0))
	gui.set_screen_position(b.shadow, vmath.vector3(spec.x + slide, spec.y - drop, 0))
	gui.set_size(b.face, vmath.vector3(size, size, 0))
	gui.set_size(b.shadow, vmath.vector3(size, size, 0))
	gui.set_size(b.icon, vmath.vector3(size * 0.62, size * 0.62, 0))
	gui.set_color(b.face, draw.withAlpha(FACE, b.shown))
	gui.set_color(b.shadow, draw.withAlpha(SHADOW, b.shown))
	gui.set_color(b.icon, draw.withAlpha(ICON, b.shown * (0.3 + 0.7 * b.enabled)))
end

function update(self, dt)
	local layout = models.layout("hud") or EMPTY
	local k = motion.blend(EASE_RATE, dt)
	local covered = (models.layout("fade") or 0) > 0.95
	local present = self.present
	for id in pairs(present) do
		present[id] = nil
	end
	for _, spec in ipairs(layout.buttons) do
		local b = self.buttons[spec.id]
		if not b then
			b = createButton(spec.id)
			self.buttons[spec.id] = b
			self.raise_tip = true
		end
		b.last = spec
		present[spec.id] = spec
	end
	for _, id in ipairs(models.takePresses("hud")) do
		if self.buttons[id] then
			self.buttons[id].scale = PULSE
		end
	end
	updateLabels(self, layout, k, covered)
	drawTooltip(self, not covered and layout.tooltip or nil, k)
	for id, b in pairs(self.buttons) do
		local spec = present[id]
		b.shown = (covered and not spec) and 0 or motion.ease(b.shown, spec and 1 or 0, k)
		b.enabled = motion.ease(b.enabled, (spec and spec.enabled) and 1 or 0, k)
		b.scale = motion.ease(b.scale, 1, k)
		drawButton(b)
	end
end
