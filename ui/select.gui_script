-- Draws the level select published in ui/models ("select": { layout, scroll, slide, thumbs,
-- thumb_scale }): the title and a dot per chapter, then one chapter's page with its banner and
-- trail, and for each level a plinth, its thumbnail (view/thumbs), its label and a badge. The
-- header hangs from one root that carries the scroll and the page from another that also
-- carries the slide, so the page is redrawn only when the layout or the fade changes. Nodes
-- are pooled by slot. Each kind of node has its own layer (ui/select.gui), so each batches
-- into one draw.
local models = require "ui.models"
local motion = require "view.motion"
local draw = require "ui.draw"

local theme = require "view.theme"

local INK = theme.vec(theme.ui.ink)
local SOFT_INK = theme.vec(theme.ui.soft_ink)
local SHADOW = theme.vec(theme.ui.shadow)
local SOLVED = theme.vec(theme.ui.solved)
local LOCKED = theme.vec(theme.ui.cell_off)
local WHITE = vmath.vector4(1, 1, 1, 1)
local FADE_RATE = 10
local PAGE = theme.vec(theme.ui.page)
local INK_MIX = 0.35
local LABEL_SIZE = 0.13
local PULSE_RATE = 2.4

local accents = {}

-- A chapter's accent, mixed toward the ink so it sits quietly on the page.
local function accentOf(name)
	if not accents[name] then
		local c = theme.vec(theme.palettes.default[name] or theme.ui.accent)
		accents[name] = c + (INK - c) * INK_MIX
	end
	return accents[name]
end

local root, head

local function box(image, sliced, parent)
	local node = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0))
	gui.set_parent(node, parent or root)
	gui.set_layer(node, "shapes")
	gui.set_texture(node, "hud")
	gui.play_flipbook(node, image)
	if sliced then
		gui.set_slice9(node, draw.SLICE)
	end
	return node
end

local function text(font, parent)
	local node = gui.new_text_node(vmath.vector3(), "")
	gui.set_parent(node, parent or root)
	gui.set_layer(node, font)
	gui.set_font(node, font)
	return node
end

local withAlpha, place, setText = draw.withAlpha, draw.place, draw.setText

local function textWidth(font, value, size)
	return resource.get_text_metrics(gui.get_font_resource(font), value).width * size / draw.FONT_SIZE[font]
end

local function drawBanner(b, spec, alpha)
	local a = alpha * (spec.enabled and 1 or 0.45)
	local accent = accentOf(spec.accent)
	local title_w = textWidth("title", spec.text, spec.size)
	local detail_size = spec.size * 0.6
	local detail_w = textWidth("body", spec.detail, detail_size)
	local gap = spec.size * 0.5
	local left = spec.x - (title_w + gap + detail_w) / 2
	setText(b.title, "title", spec.text, left, spec.y, spec.size, withAlpha(INK, a), gui.PIVOT_W)
	setText(b.detail, "body", spec.detail, left + title_w + gap, spec.y - spec.size * 0.04, detail_size, withAlpha(SOFT_INK, a), gui.PIVOT_W)
	place(b.rule, spec.x, spec.y - spec.size * 0.75, spec.size * 2.4, spec.size * 0.12, withAlpha(accent, a))
	setText(b.intro, "body", spec.intro or "", spec.x, spec.y - spec.size * 1.35, spec.size * 0.58, withAlpha(SOFT_INK, a))
end

-- The current level's halo breathes; its position is set with the rest of the node.
local halo_size, halo_color = vmath.vector3(), vmath.vector4()

local function pulseHalo(halo, spec, alpha, pulse)
	local s, grow = spec.size, 1 + 0.08 * pulse
	halo_size.x, halo_size.y = s * 1.25 * grow, s * 0.42 * grow
	gui.set_size(halo, halo_size)
	local accent = accentOf(spec.accent)
	halo_color.x, halo_color.y, halo_color.z, halo_color.w = accent.x, accent.y, accent.z, accent.w * alpha * (0.35 - 0.12 * pulse)
	gui.set_color(halo, halo_color)
end

local function drawNode(n, spec, alpha)
	local s, x, y = spec.size, spec.x, spec.y
	local locked = spec.state == "locked"
	place(n.plinth, x, y - s * 0.3, s * 0.95, s * 0.3, withAlpha(locked and LOCKED or SHADOW, alpha * (locked and 1 or 0.4)))
	gui.set_enabled(n.halo, spec.current)
	if spec.current then
		gui.set_screen_position(n.halo, vmath.vector3(x, y - s * 0.3, 0))
	end
	gui.set_enabled(n.lock, locked)
	if locked then
		place(n.lock, x, y - s * 0.05, s * 0.32, s * 0.32, withAlpha(SOFT_INK, alpha * 0.6))
	end
	local label = locked and tostring(spec.index) or ("%d  %s"):format(spec.index, spec.name)
	setText(n.label, "body", label, x, y - s * 0.62, s * LABEL_SIZE, withAlpha(locked and SOFT_INK or INK, alpha * (locked and 0.6 or 1)))
	gui.set_enabled(n.check, spec.state == "solved")
	if spec.state == "solved" then
		local label_w = textWidth("body", label, s * LABEL_SIZE)
		place(n.check, x + label_w / 2 + s * 0.12, y - s * 0.62, s * 0.14, s * 0.14, withAlpha(SOLVED, alpha))
	end
end

-- Slot i of a pool, made by `make` on first use; slots past `count` are disabled.
local function pooled(pool, count, make)
	for i = #pool + 1, count do
		pool[i] = make()
	end
	for i = 1, #pool do
		local parts = pool[i]
		for _, node in pairs(type(parts) == "table" and parts or { parts }) do
			gui.set_enabled(node, i <= count)
		end
	end
	return pool
end

local function thumbImage()
	local node = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0))
	gui.set_parent(node, root)
	gui.set_layer(node, "thumbs")
	gui.set_texture(node, "thumbs")
	return node
end

local function newNode()
	return { halo = box("dot"), plinth = box("dot"), lock = box("lock"), label = text("body"), check = box("check"), image = thumbImage() }
end

local IMAGE_RATE = 9

-- A level's thumbnail grows in once its image is drawn (at once when calm). A child of the
-- page root, which carries the scroll and slide, it is placed from the root's position and
-- then follows it; redrawn only while it changes.
-- node: the slot's image node; state: what it last showed { spec, name, shown, drawn, alpha }.
local function drawImage(self, node, state, spec, images, alpha, k, calm)
	local name = images and images[spec.id]
	if spec ~= state.spec then
		state.spec, state.shown, state.drawn = spec, 0, nil
	end
	if name and name ~= state.name then
		gui.play_flipbook(node, name)
		state.name = name
	end
	local goal = name and 1 or 0
	local shown = calm and goal or motion.ease(state.shown, goal, k, 1e-3)
	state.shown = shown
	if shown == state.drawn and alpha == state.alpha then
		return
	end
	state.drawn, state.alpha = shown, alpha
	gui.set_enabled(node, shown > 0)
	if shown > 0 then
		local s = spec.size * self.last.thumb_scale * (0.6 + 0.4 * shown)
		local origin = gui.get_screen_position(root)
		place(node, spec.x + origin.x, spec.y + spec.size * 0.08 + origin.y, s, s, withAlpha(WHITE, alpha * shown))
	end
end

local function newDot()
	return box("dot")
end

local function newMark()
	return box("dot", false, head)
end

local function drawPage(p, spec, alpha)
	place(p.shadow, spec.x, spec.y - spec.h * 0.01 - 6, spec.w * 1.01, spec.h * 1.01 + 8, withAlpha(SHADOW, alpha))
	place(p.sheet, spec.x, spec.y, spec.w, spec.h, withAlpha(PAGE, alpha))
end

-- A chapter's dot: in its accent where it is open, larger for the chapter shown.
local function drawMark(node, spec, alpha)
	local size = spec.size * (spec.current and 1.5 or 1)
	local color = spec.enabled and accentOf(spec.accent) or LOCKED
	place(node, spec.x, spec.y, size, size, withAlpha(color, alpha * (spec.current and 1 or 0.6)))
end

local function drawLayout(self, layout, alpha)
	gui.set_screen_position(root, vmath.vector3())
	gui.set_screen_position(head, vmath.vector3())
	local title = layout.title
	setText(self.title, "title", title.text, title.x, title.y, title.size, withAlpha(INK, alpha))
	local marks = pooled(self.marks, #layout.marks, newMark)
	for i, spec in ipairs(layout.marks) do
		drawMark(marks[i], spec, alpha)
	end
	drawPage(self.page, layout.page, alpha)
	drawBanner(self.banner, layout.banner, alpha)
	local dots = pooled(self.dots, #layout.trail, newDot)
	for i, dot in ipairs(layout.trail) do
		place(dots[i], dot.x, dot.y, dot.size, dot.size, withAlpha(accentOf(dot.accent), alpha * (dot.lit and 1 or 0.35)))
	end
	local nodes = pooled(self.nodes, #layout.nodes, newNode)
	self.current = nil
	for i, spec in ipairs(layout.nodes) do
		drawNode(nodes[i], spec, alpha)
		gui.set_enabled(nodes[i].image, false)
		self.images[i] = self.images[i] or { shown = 0 }
		self.images[i].drawn = nil
		if spec.current then
			self.current = { halo = nodes[i].halo, spec = spec }
		end
	end
	self.drawn, self.drawn_alpha = layout, alpha
	self.drawn_slide, self.drawn_scroll = nil, nil
end

function init(self)
	root = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0))
	head = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0))
	gui.set_visible(root, false)
	gui.set_visible(head, false)
	self.nodes, self.dots, self.marks, self.shown, self.time = {}, {}, {}, 0, 0
	self.images = {}
	self.page = { shadow = box("key", true), sheet = box("key", true) }
	self.title = text("title", head)
	self.banner = { rule = box("dot"), title = text("title"), detail = text("body"), intro = text("body") }
end

function update(self, dt)
	local model = models.layout("select")
	self.time = self.time + dt
	self.shown = motion.ease(self.shown, model and 1 or 0, motion.blend(FADE_RATE, dt))
	self.last = model or self.last
	local shown = model ~= nil or self.shown > 0.01
	gui.set_enabled(root, shown)
	gui.set_enabled(head, shown)
	if not self.last or not shown then
		return
	end
	local layout, alpha = self.last.layout, self.shown
	if layout ~= self.drawn or math.abs(alpha - self.drawn_alpha) > 1e-3 then
		drawLayout(self, layout, alpha)
	end
	if self.last.slide ~= self.drawn_slide or self.last.scroll ~= self.drawn_scroll then
		self.drawn_slide, self.drawn_scroll = self.last.slide, self.last.scroll
		gui.set_screen_position(root, vmath.vector3(self.last.slide, self.last.scroll, 0))
		gui.set_screen_position(head, vmath.vector3(0, self.last.scroll, 0))
	end
	local k = motion.blend(IMAGE_RATE, dt)
	for i, spec in ipairs(layout.nodes) do
		if spec.state ~= "locked" then
			drawImage(self, self.nodes[i].image, self.images[i], spec, self.last.thumbs, alpha, k, layout.calm)
		end
	end
	if self.current then
		local pulse = layout.calm and 0 or 0.5 + 0.5 * math.sin(self.time * PULSE_RATE)
		pulseHalo(self.current.halo, self.current.spec, alpha, pulse)
	end
end
