-- Draws the level select layout published in ui/models ("select"): chapter banners, the trail,
-- and under each level a plinth, its label and a badge. Drawn beneath the 3D thumbnails
-- (gui_back material), which sit on the plinths.
local models = require "ui.models"

local theme = require "view.theme"

local INK = theme.vec(theme.ui.ink)
local SOFT_INK = theme.vec(theme.ui.soft_ink)
local SHADOW = theme.vec(theme.ui.shadow)
local SOLVED = theme.vec(theme.ui.solved)
local LOCKED = theme.vec(theme.ui.cell_off)
local FONT_SIZE = { title = 64, body = 40 }
local FADE_RATE = 10
local PULSE_RATE = 2.4

local function accentOf(name)
	return theme.vec(theme.palettes.default[name] or theme.ui.accent)
end

local function box(image)
	local node = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0))
	gui.set_texture(node, "hud")
	gui.play_flipbook(node, image)
	return node
end

local function text(font)
	local node = gui.new_text_node(vmath.vector3(), "")
	gui.set_font(node, font)
	return node
end

local function withAlpha(color, alpha)
	local c = vmath.vector4(color)
	c.w = c.w * alpha
	return c
end

local function place(node, x, y, w, h, color)
	gui.set_screen_position(node, vmath.vector3(x, y, 0))
	gui.set_size(node, vmath.vector3(w, h, 0))
	gui.set_color(node, color)
end

local function setText(node, font, value, x, y, size, color, pivot)
	gui.set_text(node, value)
	gui.set_pivot(node, pivot or gui.PIVOT_CENTER)
	gui.set_screen_position(node, vmath.vector3(x, y, 0))
	local s = size / FONT_SIZE[font]
	gui.set_scale(node, vmath.vector3(s, s, 1))
	gui.set_color(node, color)
end

local function textWidth(font, value, size)
	return resource.get_text_metrics(gui.get_font_resource(font), value).width * size / FONT_SIZE[font]
end

local function drawBanner(b, spec, alpha)
	local a = alpha * (spec.enabled and 1 or 0.45)
	local accent = accentOf(spec.accent)
	local title_w = textWidth("title", spec.text, spec.size)
	local detail_size = spec.size * 0.6
	local detail_w = textWidth("body", spec.detail, detail_size)
	local gap = spec.size * 0.5
	local left = spec.x - (title_w + gap + detail_w) / 2
	setText(b.title, "title", spec.text, left, spec.y, spec.size, withAlpha(INK, a), gui.PIVOT_W)
	setText(b.detail, "body", spec.detail, left + title_w + gap, spec.y - spec.size * 0.04, detail_size, withAlpha(SOFT_INK, a), gui.PIVOT_W)
	place(b.rule, spec.x, spec.y - spec.size * 0.75, spec.size * 2.4, spec.size * 0.12, withAlpha(accent, a))
	setText(b.intro, "body", spec.intro or "", spec.x, spec.y - spec.size * 1.35, spec.size * 0.58, withAlpha(SOFT_INK, a))
end

local function drawNode(n, spec, alpha, pulse)
	local s, x, y = spec.size, spec.x, spec.y
	local accent = accentOf(spec.accent)
	local locked = spec.state == "locked"
	place(n.plinth, x, y - s * 0.3, s * 0.95, s * 0.3, withAlpha(locked and LOCKED or SHADOW, alpha))
	gui.set_enabled(n.halo, spec.current)
	if spec.current then
		local grow = 1 + 0.08 * pulse
		place(n.halo, x, y - s * 0.3, s * 1.25 * grow, s * 0.42 * grow, withAlpha(accent, alpha * (0.55 - 0.2 * pulse)))
	end
	gui.set_enabled(n.lock, locked)
	if locked then
		place(n.lock, x, y - s * 0.05, s * 0.32, s * 0.32, withAlpha(SOFT_INK, alpha * 0.6))
	end
	local label = locked and tostring(spec.index) or ("%d  %s"):format(spec.index, spec.name)
	setText(n.label, "body", label, x, y - s * 0.62, s * 0.13, withAlpha(locked and SOFT_INK or INK, alpha * (locked and 0.6 or 1)))
	gui.set_enabled(n.check, spec.state == "solved")
	if spec.state == "solved" then
		local label_w = textWidth("body", label, s * 0.13)
		place(n.check, x + label_w / 2 + s * 0.12, y - s * 0.62, s * 0.14, s * 0.14, withAlpha(SOLVED, alpha))
	end
end

local function banner(self, id)
	self.banners[id] = self.banners[id] or { rule = box("dot"), title = text("title"), detail = text("body"), intro = text("body") }
	return self.banners[id]
end

local function levelNode(self, id)
	self.nodes[id] = self.nodes[id] or {
		halo = box("dot"), plinth = box("dot"), lock = box("lock"), label = text("body"), check = box("check"),
	}
	return self.nodes[id]
end

local function drawTrail(self, trail, alpha)
	for i, dot in ipairs(trail) do
		self.dots[i] = self.dots[i] or box("dot")
		gui.set_enabled(self.dots[i], true)
		place(self.dots[i], dot.x, dot.y, dot.size, dot.size, withAlpha(accentOf(dot.accent), alpha * (dot.lit and 1 or 0.35)))
	end
	for i = #trail + 1, #self.dots do
		gui.set_enabled(self.dots[i], false)
	end
end

function init(self)
	self.nodes, self.banners, self.dots, self.shown, self.time = {}, {}, {}, 0, 0
	self.title = text("title")
end

function update(self, dt)
	local layout = models.layout("select")
	self.time = self.time + dt
	self.shown = self.shown + ((layout and 1 or 0) - self.shown) * (1 - math.exp(-FADE_RATE * dt))
	self.last = layout or self.last
	local last = self.last
	if not last then
		return
	end
	local alpha = self.shown
	local title = last.title
	setText(self.title, "title", title.text, title.x, title.y, title.size, withAlpha(INK, alpha))
	drawTrail(self, last.trail, alpha)
	for _, spec in ipairs(last.banners) do
		drawBanner(banner(self, spec.id), spec, alpha)
	end
	local pulse = last.calm and 0 or 0.5 + 0.5 * math.sin(self.time * PULSE_RATE)
	for _, spec in ipairs(last.nodes) do
		drawNode(levelNode(self, spec.id), spec, alpha, pulse)
	end
end
