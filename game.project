[project]
title = Third Angle
custom_resources = /levels
dependencies#0 = https://github.com/subsoap/defos/archive/refs/heads/master.zip
dependencies#1 = https://github.com/defold/extension-automation-bridge/archive/refs/tags/2.6.0.zip

[bootstrap]
main_collection = /main/main.collectionc
render = /render/game.renderc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[mesh]
max_count = 512

[display]
width = 1280
height = 720
high_dpi = 1
samples = 4

[script]
shared_state = 1

[windows]
app_icon = /assets/app_icons/appicon.ico

[osx]
app_icon = /assets/app_icons/appicon.icns

[android]
input_method = HiddenInputField


[html5]
scale_mode = stretch
cssfile = /web/theme.css
splash_image = /web/splash.png
show_fullscreen_button = 0
show_made_with_defold = 0
show_console_banner = 0


