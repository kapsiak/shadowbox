#version 140

in highp vec4 position;
in mediump vec3 normal;
in mediump vec2 texcoord0;

out mediump vec2 var_uv;
out mediump float var_facing;

uniform vs_uniforms
{
    highp mat4 mtx_worldview;
    highp mat4 mtx_proj;
};

void main()
{
    vec4 p = mtx_worldview * vec4(position.xyz, 1.0);
    vec3 n = normalize((mtx_worldview * vec4(normal, 0.0)).xyz);
    var_uv = texcoord0;
    var_facing = dot(n, normalize(-p.xyz));
    gl_Position = mtx_proj * p;
}
