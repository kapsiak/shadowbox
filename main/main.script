-- The outer loop. Defold callbacks only queue input; update() runs the phases in order:
--   layout   the active screen lays out its interface for this frame
--   gather   raw input -> on-screen controls or gestures -> intents (skipped during a fade)
--   apply    intents -> the active screen, which may return a request for the app
--   record   boards and solved levels are recorded; autosave
--   fade     a pending screen change fades out, switches, and fades back in
--   present  the active screen shows its state; views ease toward it
--   sound    sound cues recorded this frame are played
--
-- A screen is a table with a `module` implementing:
--   layout(screen, info), hit(screen, x, y) -> control id, button(screen, control_event, intents),
--   gesture(screen, g, intents), apply(screen, intent, dt) -> request or nil,
--   present(screen, dt, info), exit(screen)
-- Requests: { to = "menu" | "select" | "continue" | "next" | "play", pack, index },
--           { setting = key, value = v }, { reset_progress = true }, { seen = card id }, { quit = true }
local catalog_loader = require "main.catalog"
local storage = require "main.storage"
local menu_screen = require "main.menu_screen"
local play_screen = require "main.play_screen"
local select_screen = require "main.select_screen"
local board_pool = require "view.board_pool"
local thumbs = require "view.thumbs"
local progress = require "game.progress"
local settings = require "game.settings"
local save_data = require "game.save_data"
local actions = require "input.actions"
local router = require "input.router"
local gestures = require "input.gestures"
local models = require "ui.models"
local audio = require "view.audio"
local theme = require "view.theme"
local frame = require "render.frame"
local cameras = require "view.cameras"
local controls = require "input.controls"

local DRAG_THRESHOLD = 0.012
local FADE_OUT, FADE_IN = 0.2, 0.3
-- Unsaved changes are written once they settle for SAVE_DELAY, and at least every SAVE_CAP;
-- solving, changing screen, losing focus and quitting save at once.
local SAVE_DELAY = 0.5
local SAVE_CAP = 5

local function save(self)
	local app = { progress = self.saved, settings = self.settings, last = self.last, boards = self.boards }
	if storage.save(save_data.encode(app, self.catalog)) then
		self.dirty = nil
	else
		self.dirty = { since = self.time, changed = self.time }
	end
end

local function markDirty(self)
	self.dirty = self.dirty or { since = self.time }
	self.dirty.changed = self.time
end

local function flush(self)
	if self.dirty then
		save(self)
	end
end

local function autosave(self)
	local dirty = self.dirty
	if dirty and (self.time - dirty.changed > SAVE_DELAY or self.time - dirty.since > SAVE_CAP) then
		save(self)
	end
end

-- Touch-first devices: phones and tablets, natively or in a browser (whose system is "HTML5",
-- so the browser is asked whether its main pointer is a finger).
local function isTouchFirst()
	if html5 then
		return html5.run("matchMedia('(pointer: coarse)').matches") == "true"
	end
	return ({ Android = true, ["iPhone OS"] = true })[sys.get_sys_info().system_name] == true
end

local mobile = isTouchFirst()

-- Browsers allow fullscreen only after a tap or key (so it is not restored on start), and iPhones
-- not at all.
local function canFullscreen()
	if html5 then
		return html5.run("document.fullscreenEnabled || document.webkitFullscreenEnabled || false") == "true"
	end
	return not mobile
end

local can_fullscreen = defos ~= nil and canFullscreen()

-- The screen as the active screen sees it: one table, updated in place each frame. The safe
-- area and display scale are read again when the window size changes or it reports a resize.
-- `geometry` counts changes to w, h, scale and safe, so a layout can watch that one value.
local function screenInfo(self)
	local info = self.info
	local w, h = window.get_size()
	w, h = math.max(w, 1), math.max(h, 1)
	if w ~= info.w or h ~= info.h or self.resized then
		local area = window.get_safe_area()
		local safe = info.safe
		info.w, info.h, info.display_scale = w, h, window.get_display_scale()
		safe.left, safe.right, safe.top, safe.bottom = area.inset_left, area.inset_right, area.inset_top, area.inset_bottom
		info.geometry = info.geometry + 1
		self.resized = false
	end
	local scale = info.display_scale * self.settings.ui_scale
	if scale ~= info.scale then
		info.scale, info.geometry = scale, info.geometry + 1
	end
	info.settings = self.settings
	info.can_continue = self.last ~= nil
	info.seen = self.saved.seen
	return info
end

local function countSolved(self)
	self.info.solved, self.info.total = progress.totals(self.saved, self.catalog)
end

local function switchTo(self, screen)
	flush(self)
	if self.screen then
		self.screen.module.exit(self.screen)
	end
	self.screen = screen
	self.router = router.new()
	self.gestures = gestures.new(0)
end

local function openLevel(self, pack_index, level_index)
	self.last = { pack = pack_index, index = level_index }
	markDirty(self)
	local pack = self.catalog.packs[pack_index]
	local key = pack.keys[level_index]
	switchTo(self, play_screen.enter(pack, level_index, self.pool, self.factories, self.boards[key], self.sessions[key],
		self.rules, self.saved.seen))
	self.sessions[key] = self.screen.session
end

-- The level "Continue" resumes: the last one played if unsolved, else the next open one.
local function continueTarget(self)
	local last = self.last
	if last and self.catalog.packs[last.pack] and self.catalog.packs[last.pack].keys[last.index] then
		if not progress.isSolved(self.saved, self.catalog.packs[last.pack].keys[last.index]) then
			return last.pack, last.index
		end
		return progress.next(self.saved, self.catalog, last.pack, last.index, self.settings.open_all)
	end
	return progress.next(self.saved, self.catalog, 1, 0, self.settings.open_all)
end

local function changeScreen(self, request)
	local to = request.to
	if to == "menu" then
		switchTo(self, menu_screen.enter(self.showcase, self.pool, self.rules))
	elseif to == "play" then
		openLevel(self, request.pack, request.index)
	elseif to == "next" or to == "continue" then
		local p, l
		if to == "next" then
			p, l = progress.next(self.saved, self.catalog, self.last.pack, self.last.index, self.settings.open_all)
		else
			p, l = continueTarget(self)
		end
		if p then
			openLevel(self, p, l)
		else
			switchTo(self, select_screen.enter(self.catalog, self.saved, self.boards, self.pool, self.last, self.thumb_atlas))
		end
	elseif to == "select" then
		switchTo(self, select_screen.enter(self.catalog, self.saved, self.boards, self.pool, self.last, self.thumb_atlas))
	end
end

local function applyRenderScale(self)
	frame.scale = settings.renderScale(self.settings.quality, window.get_display_scale())
end

-- Applies the settings that act on the engine, the window and input rather than on a screen.
local function applyDisplay(self)
	local prefs = self.settings
	self.keymap = controls.keymap(prefs.bindings)
	sys.set_vsync_swap_interval(prefs.frame_rate == 0 and 1 or 0)
	sys.set_update_frequency(prefs.frame_rate)
	applyRenderScale(self)
	if can_fullscreen and defos.is_fullscreen() ~= prefs.fullscreen then
		defos.set_fullscreen(prefs.fullscreen)
	end
end

local function handle(self, request)
	if request.to then
		self.fade = self.fade or { alpha = 0, request = request }
	elseif request.setting then
		self.settings = settings.with(self.settings, request.setting, request.value)
		markDirty(self)
		applyDisplay(self)
	elseif request.seen then
		progress.markSeen(self.saved, request.seen)
		markDirty(self)
	elseif request.reset_progress then
		self.saved = progress.new()
		self.last = nil
		self.boards = {}
		self.sessions = {}
		countSolved(self)
		save(self)
	elseif request.quit then
		flush(self)
		sys.exit(0)
	end
end

local none = {}

-- The intents of this frame's input; a frame without input allocates nothing.
local function gather(self, info)
	if #self.raw_input == 0 then
		return none
	end
	local screen = self.screen
	local module = screen.module
	self.gestures.threshold = DRAG_THRESHOLD * math.min(info.w, info.h)
	local function hitAt(x, y)
		return module.hit(screen, x, y)
	end
	local intents = {}
	for _, raw in ipairs(self.raw_input) do
		local events = {}
		local passed = router.route(self.router, raw, hitAt, events)
		for _, ev in ipairs(events) do
			if ev.phase == "press" then
				audio.cue("ui_tap")
			end
			module.button(screen, ev, intents)
		end
		for _, g in ipairs(passed and gestures.feed(self.gestures, passed) or {}) do
			module.gesture(screen, g, intents)
		end
	end
	self.raw_input = {}
	return intents
end

-- Records the board in play and saves a newly solved level at once.
local function record(self)
	local screen = self.screen
	if screen.module == play_screen then
		local board = play_screen.board(screen)
		if self.boards[screen.key] ~= board then
			self.boards[screen.key] = board
			markDirty(self)
		end
		if screen.solved and not progress.isSolved(self.saved, screen.key) then
			progress.markSolved(self.saved, screen.key)
			countSolved(self)
			save(self)
			if progress.solvedCount(self.saved, screen.pack) == #screen.pack.keys then
				play_screen.chapterComplete(screen, self.catalog.packs[self.last.pack + 1] ~= nil)
			end
		end
	end
	autosave(self)
end

-- Fades out, performs the pending screen change at full cover, then fades back in.
local function stepFade(self, dt)
	local fade = self.fade
	if not fade then
		return
	end
	if fade.request then
		fade.alpha = math.min(1, fade.alpha + dt / FADE_OUT)
		if fade.alpha >= 1 then
			changeScreen(self, fade.request)
			fade.request = nil
		end
	else
		fade.alpha = math.max(0, fade.alpha - dt / FADE_IN)
		if fade.alpha <= 0 then
			self.fade = nil
		end
	end
	models.publish("fade", self.fade and self.fade.alpha * self.fade.alpha * (3 - 2 * self.fade.alpha) or 0)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.raw_input = {}
	self.time = 0
	self.factories = {
		piece = msg.url("#piece_factory"), panel = msg.url("#panel_factory"), tray_piece = msg.url("#tray_piece_factory"),
		anchor = msg.url("#anchor_factory"),
		glass_piece = msg.url("#glass_piece_factory"), glass_tray_piece = msg.url("#glass_tray_piece_factory"),
		ghost_piece = msg.url("#ghost_piece_factory"),
	}
	self.pool = board_pool.new(self.factories)
	self.thumb_atlas = thumbs.createAtlas()
	go.set("/select#select", "textures", self.thumb_atlas, { key = "thumbs" })
	self.info = {
		w = 0, h = 0, display_scale = 1, scale = 0, geometry = 0, safe = {},
		can_fullscreen = can_fullscreen, has_keyboard = not mobile, can_quit = not html5 and not mobile,
		title = sys.get_config_string("project.title", ""),
		version = sys.get_config_string("project.version", ""),
	}
	self.catalog = assert(catalog_loader.load(sys.get_config_string("project.levels", catalog_loader.INDEX)))
	self.showcase = assert(catalog_loader.loadShowcase())
	self.rules = assert(catalog_loader.loadRules(self.catalog))
	local data = save_data.decode(storage.load(), self.catalog)
	self.saved = data.progress
	self.settings = data.settings
	self.last = data.last
	self.boards = data.boards
	self.sessions = {}
	countSolved(self)
	window.set_listener(function(_, event)
		if event == window.WINDOW_EVENT_FOCUS_LOST or event == window.WINDOW_EVENT_ICONIFIED then
			self.raw_input[#self.raw_input + 1] = { kind = "blur" }
			audio.setFocused(false)
			flush(self)
		elseif event == window.WINDOW_EVENT_FOCUS_GAINED or event == window.WINDOW_EVENT_DEICONIFIED then
			audio.setFocused(true)
		elseif event == window.WINDOW_EVENT_RESIZED then
			self.resized = true
			if can_fullscreen and defos.is_fullscreen() ~= self.settings.fullscreen then
				self.settings = settings.with(self.settings, "fullscreen", defos.is_fullscreen())
				markDirty(self)
			end
			applyRenderScale(self)
		end
	end)
	if html5 then
		self.settings = settings.with(self.settings, "fullscreen", false)
	end
	applyDisplay(self)
	go.set("/background#mesh", "top", theme.vec(theme.background.top))
	go.set("/background#mesh", "bottom", theme.vec(theme.background.bottom))
	go.set("/background#mesh", "glow", theme.vec(theme.background.glow))
	go.set("/background#mesh", "lattice", theme.vec(theme.background.lattice))
	local tray = theme.tray
	go.set("/tray_backdrop#mesh", "fill", theme.vec(tray.color))
	go.set("/tray_backdrop#mesh", "lip", theme.vec(tray.lip))
	go.set("/tray_backdrop#mesh", "corner", vmath.vector4(tray.chamfer, 0, 0, 0))
	switchTo(self, menu_screen.enter(self.showcase, self.pool, self.rules))
	audio.startMusic()
	local info = screenInfo(self)
	self.screen.module.layout(self.screen, info)
	self.screen.module.present(self.screen, 0, info)
end

function update(self, dt)
	self.time = self.time + dt
	local info = screenInfo(self)
	local screen = self.screen
	screen.module.layout(screen, info)
	local intents = gather(self, info)
	if not self.fade then
		for _, intent in ipairs(intents) do
			local request = screen.module.apply(screen, intent, dt)
			if request then
				handle(self, request)
			end
		end
	end
	record(self)
	stepFade(self, dt)
	info = screenInfo(self)
	self.screen.module.layout(self.screen, info)
	self.screen.module.present(self.screen, dt, info)
	if self.fade then
		cameras.clear("card")
	end
	if info.w / info.h ~= self.aspect then
		self.aspect = info.w / info.h
		go.set("/background#mesh", "aspect", vmath.vector4(self.aspect, 0, 0, 0))
	end
	audio.flush(self.settings)
end

function final(self)
	flush(self)
end

function on_input(self, action_id, action)
	local raw = actions.read(action_id, action, self.keymap)
	if raw then
		self.raw_input[#self.raw_input + 1] = raw
	end
end
