-- Pass order: thumbs (level thumbnails drawn into their render target, only on frames that
-- publish shots), background, gui_back (screens drawn beneath 3D), board (panels, cubes, glass),
-- tray (own camera, fresh depth), gui, card (a rule card's scene in its own viewport over the GUI).
-- The card's board stands far from the play board, so each camera sees only its own.
-- Panels always sit behind the board, so drawing them first lets see-through cubes blend over them.
-- Glass comes last, blended over everything else.
local cameras = require "view.cameras"
local frame = require "render.frame"

local predicates = {}

function init(self)
	for _, name in ipairs({ "background", "cube", "glass", "panel", "backdrop", "tray", "tray_glass", "blit", "gui_back", "gui", "debug_text" }) do
		predicates[name] = render.predicate({ name })
	end
	self.clear = {
		[graphics.BUFFER_TYPE_COLOR0_BIT] = vmath.vector4(0, 0, 0, 1),
		[graphics.BUFFER_TYPE_DEPTH_BIT] = 1,
		[graphics.BUFFER_TYPE_STENCIL_BIT] = 0,
	}
	self.clear_depth = { [graphics.BUFFER_TYPE_DEPTH_BIT] = 1 }
	self.clear_empty = {
		[graphics.BUFFER_TYPE_COLOR0_BIT] = vmath.vector4(0, 0, 0, 0),
		[graphics.BUFFER_TYPE_DEPTH_BIT] = 1,
	}
end

local function usePass(pass)
	render.set_view(pass.view)
	render.set_projection(pass.proj)
	return pass.options
end

-- Glass is premultiplied, blended over what lies behind it without writing depth.
local function drawGlass(predicate, options)
	render.set_depth_mask(false)
	render.draw(predicate, options)
	render.set_depth_mask(true)
end

local function drawBoard(pass)
	local options = usePass(pass)
	render.enable_state(graphics.STATE_DEPTH_TEST)
	render.set_depth_mask(true)
	render.enable_state(graphics.STATE_BLEND)

	render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
	render.disable_state(graphics.STATE_CULL_FACE)
	render.draw(predicates.panel, options)

	render.set_blend_func(graphics.BLEND_FACTOR_ONE, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
	render.enable_state(graphics.STATE_CULL_FACE)
	render.draw(predicates.cube, options)
	drawGlass(predicates.glass, options)
	render.draw_debug3d()
end

-- Draws each shot of a snapshot pass into its viewport of the pass's render target.
local function drawShots(self, pass)
	render.set_render_target(pass.target)
	if pass.clear then
		render.clear(self.clear_empty)
	end
	for _, shot in ipairs(pass.shots) do
		local v = shot.viewport
		render.set_viewport(v.x, v.y, v.w, v.h)
		render.clear(self.clear_depth)
		drawBoard(shot)
	end
	render.disable_state(graphics.STATE_CULL_FACE)
	render.disable_state(graphics.STATE_DEPTH_TEST)
	render.set_render_target(render.RENDER_TARGET_DEFAULT)
end

local function drawTray(pass, clear_depth)
	render.disable_state(graphics.STATE_DEPTH_TEST)
	render.disable_state(graphics.STATE_CULL_FACE)
	render.set_blend_func(graphics.BLEND_FACTOR_ONE, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
	render.draw(predicates.backdrop)
	render.enable_state(graphics.STATE_DEPTH_TEST)
	render.enable_state(graphics.STATE_CULL_FACE)
	render.clear(clear_depth)
	local options = usePass(pass)
	render.draw(predicates.tray, options)
	drawGlass(predicates.tray_glass, options)
	render.disable_state(graphics.STATE_CULL_FACE)
	render.disable_state(graphics.STATE_DEPTH_TEST)
end

local IDENTITY = vmath.matrix4()
local gui_proj = { w = 0, h = 0 }

local function drawGui(w, h, ...)
	if w ~= gui_proj.w or h ~= gui_proj.h then
		gui_proj.w, gui_proj.h, gui_proj.matrix = w, h, vmath.matrix4_orthographic(0, w, 0, h, -1, 1)
	end
	render.set_view(IDENTITY)
	render.set_projection(gui_proj.matrix)
	render.disable_state(graphics.STATE_DEPTH_TEST)
	render.disable_state(graphics.STATE_CULL_FACE)
	render.enable_state(graphics.STATE_BLEND)
	render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
	render.enable_state(graphics.STATE_STENCIL_TEST)
	for i = 1, select("#", ...) do
		render.draw((select(i, ...)))
	end
	render.disable_state(graphics.STATE_STENCIL_TEST)
	render.disable_state(graphics.STATE_BLEND)
end

-- An offscreen target for drawing the scene below native resolution, rebuilt when the
-- window or the scale changes.
local function sceneTarget(self, w, h)
	local rw, rh = math.max(1, math.floor(w * frame.scale)), math.max(1, math.floor(h * frame.scale))
	if self.target and self.target_w == rw and self.target_h == rh then
		return self.target, rw, rh
	end
	if self.target then
		render.delete_render_target(self.target)
	end
	local color = {
		format = graphics.TEXTURE_FORMAT_RGBA, width = rw, height = rh,
		min_filter = graphics.TEXTURE_FILTER_LINEAR, mag_filter = graphics.TEXTURE_FILTER_LINEAR,
		u_wrap = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE, v_wrap = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,
	}
	local depth = {
		format = graphics.TEXTURE_FORMAT_DEPTH, width = rw, height = rh,
		u_wrap = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE, v_wrap = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,
	}
	self.target = render.render_target({
		sample_count = 4, [graphics.BUFFER_TYPE_COLOR0_BIT] = color, [graphics.BUFFER_TYPE_DEPTH_BIT] = depth,
	})
	self.target_w, self.target_h = rw, rh
	return self.target, rw, rh
end

local function blit(self, w, h)
	render.set_render_target(render.RENDER_TARGET_DEFAULT)
	render.set_viewport(0, 0, w, h)
	render.clear(self.clear)
	render.disable_state(graphics.STATE_BLEND)
	render.disable_state(graphics.STATE_DEPTH_TEST)
	render.enable_texture("frame", self.target, graphics.BUFFER_TYPE_COLOR0_BIT)
	render.draw(predicates.blit)
	render.disable_texture("frame")
end

function update(self)
	local w, h = render.get_window_width(), render.get_window_height()
	if w == 0 or h == 0 then
		return
	end
	local thumbs = cameras.get("thumbs")
	if thumbs then
		drawShots(self, thumbs)
	end
	local scaled = frame.scale < 1
	if scaled then
		local target, rw, rh = sceneTarget(self, w, h)
		render.set_render_target(target)
		render.set_viewport(0, 0, rw, rh)
	else
		render.set_viewport(0, 0, w, h)
	end
	render.set_depth_mask(true)
	render.set_stencil_mask(0xff)
	render.clear(self.clear)

	render.draw(predicates.background)
	drawGui(w, h, predicates.gui_back)
	local board, tray = cameras.get("board"), cameras.get("tray")
	if board then
		drawBoard(board)
	end
	if tray then
		drawTray(tray, self.clear_depth)
	end
	if scaled then
		blit(self, w, h)
	end
	drawGui(w, h, predicates.gui, predicates.debug_text)
	local card = cameras.get("card")
	if card and card.viewport then
		local v = card.viewport
		render.set_viewport(v.x, v.y, v.w, v.h)
		render.clear(self.clear_depth)
		drawBoard(card)
		render.disable_state(graphics.STATE_CULL_FACE)
		render.disable_state(graphics.STATE_DEPTH_TEST)
		render.set_viewport(0, 0, w, h)
	end
end
